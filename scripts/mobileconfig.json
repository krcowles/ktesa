{
  "compilerOptions": {
      "moduleResolution": "Node",
      "target": "ESNext",
      "module": "ESNext",
      "lib": ["DOM", "DOM.Iterable", "ESNext"],
      "skipLibCheck": true,
      "strict": true,
      "noImplicitAny": true,
      "alwaysStrict": true,
      "noUnusedLocals": true,
      "noUnusedParameters": true,
      "noImplicitReturns": true,
      "noFallthroughCasesInSwitch": true,
      "allowSyntheticDefaultImports": true, 
      "allowJs": true
  },
  "exclude": [
    "**/*.js"
  ],
  "files": [
    "cacheDeleteFct.ts",
    "ktesaOfflineDB.ts",
    "landing.ts",
    "loginState.ts",
    "logo.ts",
    "mapOnly.ts",
    "navMenu.ts",
    "responsiveCaptions.ts",
    "responsivePage.ts",
    "responsivePics.ts",
    "responsiveTable.ts",
    "searchbar.ts",
    "update.ts",
    "useOffline.ts",
    "viewMgr.ts"
  ]
}
